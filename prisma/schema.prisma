// Prisma schema — Postgres (Supabase). The session table is managed by Supabase
// migrations (table name `shopify_sessions`); Prisma is used only as the client
// for @shopify/shopify-app-session-storage-prisma.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id                  String    @id @db.VarChar
  shop                String    @db.VarChar
  state               String    @db.VarChar
  isOnline            Boolean   @default(false)
  scope               String?   @db.VarChar
  expires             DateTime? @db.Timestamptz
  accessToken         String?   @db.VarChar
  userId              BigInt?
  firstName           String?   @db.VarChar
  lastName            String?   @db.VarChar
  email               String?   @db.VarChar
  accountOwner        Boolean   @default(false)
  locale              String?   @db.VarChar
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?   @db.VarChar
  // session-storage-prisma v9 writes/reads this as a Date (rowToSession calls
  // .getTime()); a BigInt column makes every session upsert throw
  // PrismaClientValidationError and 500s authenticate.admin.
  refreshTokenExpires DateTime? @db.Timestamptz

  @@map("shopify_sessions")
}
