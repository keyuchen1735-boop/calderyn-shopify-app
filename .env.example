SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SCOPES=read_products,read_inventory,write_inventory,read_orders,read_locations
SHOPIFY_APP_URL=https://example.com

# Supabase (server-only — service role key bypasses RLS)
SUPABASE_URL=https://ajgrmnvzxfxxlwrxcgnu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Prisma session storage.
# Use the "Transaction pooler" connection string (port 6543) from Supabase
# Project Settings → Database → Connection String → URI, with
# `?pgbouncer=true&connection_limit=1` appended for Prisma.
DATABASE_URL=

# Direct connection for `prisma migrate dev` (migrations cannot run through
# the transaction pooler). Use the "Session pooler" string (port 5432).
DIRECT_URL=

# Calderyn backend wiring (legacy; superseded by Supabase. Leave empty.)
CALDERYN_API_URL=
CALDERYN_SERVICE_TOKEN=

# HMAC pepper for hashing MCP bearer tokens. 32+ random bytes (hex).
# Must match the value set in calderyn-mcp's Vercel env. Rotating it invalidates all live tokens.
MCP_TOKEN_PEPPER=replace-with-32-byte-random-hex

# Shared secret for authenticating Vercel Cron requests to /cron/ingest
# and the /api/engine/run python function. 32+ random bytes (hex).
# Set the same value in Vercel project env.
CRON_SECRET=replace-with-32-byte-random-hex

# === Daily GitHub progress digest (cron.github-digest, `0 14 * * *`) ===
# Emails a plain-English summary of the last 24h of repo activity. The cron
# returns 500 (visible-red in the Vercel dashboard) until GITHUB_TOKEN,
# RESEND_API_KEY, and DIGEST_FROM are all set. ANTHROPIC_API_KEY (above) is
# reused for the prose summary; without it the digest falls back to a grouped
# template. Server-only — never expose in a client bundle.
#
# Fine-grained PAT with read access to the repo (contents + pull requests).
GITHUB_TOKEN=
# Resend API key (https://resend.com).
RESEND_API_KEY=
# Verified Resend sender, e.g. Calderyn <digest@yourdomain.com>.
DIGEST_FROM=
# Primary recipient of the digest (To).
DIGEST_TO=kennethlee@calderyncompany.com
# Optional CC recipients, comma-separated.
DIGEST_CC=keyuchen@calderyncompany.com,john@calderyncompany.com
# Repo to summarize (owner/name).
DIGEST_REPO=keyuchen1735-boop/calderyn-shopify-app

# === Social digest (weekly LinkedIn + Instagram carousel email) ===
# Recipients of the weekly approve/reject email, comma-separated. OPTIONAL:
# defaults to the three founders if unset. Reuses RESEND_API_KEY + DIGEST_FROM.
SOCIAL_DIGEST_TO=
# Base URL for the approve/reject + LinkedIn-connect links. Default:
# https://app.calderyncompany.com
SOCIAL_DIGEST_BASE_URL=
# HMAC secret for the signed approve/reject + OAuth-state tokens. OPTIONAL:
# falls back to CRON_SECRET if unset.
SOCIAL_ACTION_SECRET=
# LinkedIn auto-post (Phase 2). App credentials from linkedin.com/developers.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Dedicated, rotatable key gating /social/linkedin/connect (NOT CRON_SECRET).
# Set for the one-time OAuth connect, then remove/rotate.
LINKEDIN_SETUP_KEY=

# === Daily LinkedIn post sender (api.linkedin-digest) ===
# Bearer secret the Claude cloud routine "Daily LinkedIn Post Writer" sends to
# POST /api/linkedin-digest. The routine writes the 3 daily posts and this
# endpoint sends them via Resend, so RESEND_API_KEY stays server-side (it never
# touches the routine config). Recipients are restricted to @calderyncompany.com.
# Reuses RESEND_API_KEY + DIGEST_FROM for delivery. Generate with:
# openssl rand -hex 32.
LINKEDIN_DIGEST_SECRET=

# === Bug reports ("Report a bug" launcher, app/lib/bug-report) ===
# Recipients for merchant-submitted bug reports, comma-separated. OPTIONAL: if
# unset, reports go to DIGEST_TO + DIGEST_CC (already the team). Reuses
# RESEND_API_KEY + DIGEST_FROM to send; screenshots are stored in the private
# Supabase Storage bucket `bug-reports`.
BUG_REPORT_TO=

# Python detector engine (Vercel python fn at /api/engine/run).
# The engine connects via asyncpg using DATABASE_URL above (transaction
# pooler is fine: the pool is created with statement_cache_size=0, see
# engine/calderyn_engine/db.py). Additional keys it needs:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Leave MOAT_PEPPER unset: no moat_* tables exist, so the moat layer is a no-op.

# Engine DB-backed tests ONLY. Points at a DISPOSABLE LOCAL Postgres carrying
# the engine schema (see tests/engine/scripts/test-db.sh). The engine test
# suite reads ONLY this var (never DATABASE_URL) and refuses any non-loopback
# host, so it can never read or mutate a shared/remote database. Leave unset to
# skip the DB-backed tests. Never point this at Supabase or any real database.
TEST_DATABASE_URL=postgres://postgres:test@localhost:5433/calderyn_test

# AES-256-GCM key for encrypting stored integration OAuth tokens at rest.
# Exactly 32 bytes as 64 hex chars.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-char-random-hex

# Onboarding skip-setup shortcut. Renders a "Skip setup → dashboard" button that
# bypasses guardrail setup and privacy/consent. ONLY set to "true" on
# preview/staging while OAuth providers are being wired. MUST be unset (or any
# value other than "true") in the production merchant environment.
ONBOARDING_DEV_BYPASS=

# Meta (Facebook) Marketing API. A developer app in Development mode is enough to
# test pause/resume on your own ad account (no App Review required).
META_APP_ID=
META_APP_SECRET=

# Anthropic API — in-app assistant (server-only; never in a client bundle).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model string is verified against the live API at build time (spec §10.1).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Digest crons (github/social) default to Haiku — cheaper, low-volume, with
# deterministic template fallbacks. Override to use a different model.
DIGEST_MODEL=claude-haiku-4-5

# Higgsfield — image generation (screener "Improve → Image" + store-generator listing
# imagery; server-only). Key + secret pair from cloud.higgsfield.ai → API. Both required,
# or image gen stays gated off / degrades to keeping the source image. Auth header is
# `Key {key}:{secret}`.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Daily caps on image generation (shared Higgsfield account). Optional — these are
# the defaults. Per-merchant cap and a global backstop so the bill can't run away.
IMAGE_GEN_DAILY_PER_SHOP=20
IMAGE_GEN_DAILY_GLOBAL=300

# Google Ads API (cron.ingest-ads ad-spend ingestion). The OAuth connect flow
# (/auth/google) exchanges the merchant's consent for a long-lived refresh
# token, stores it encrypted in integration_credentials (kind google_ads), and
# the Google adapter refreshes it into access tokens to call the Ads REST API.
# CLIENT_ID/SECRET come from a Google Cloud OAuth 2.0 client (Web application)
# whose authorized redirect URI must include `${SHOPIFY_APP_URL}/auth/google`.
# DEVELOPER_TOKEN comes from the Google Ads API Center; it must be **Basic** (or
# Standard) access — a test-access token 403s on real merchant accounts with
# DEVELOPER_TOKEN_NOT_APPROVED. Separately, the Google Cloud OAuth consent screen
# must be External + verified before non-test merchants can connect cleanly (the
# `adwords` scope is sensitive); an unverified app caps at 100 users and shows an
# "unverified app" warning. A dead/revoked refresh token surfaces as invalid_grant
# and flips the integration to "reauth" (settings shows "Reconnect needed").
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# TikTok Business (Marketing API). The OAuth connect flow (/auth/tiktok)
# exchanges the merchant's auth code for an access token + advertiser id, stored
# encrypted in integration_credentials (kind tiktok_ads). Least-privilege scopes
# only (advertiser reporting + campaign read/manage). Create a developer app at
# https://business-api.tiktok.com/; its redirect/callback URL must be set to
# `${SHOPIFY_APP_URL}/auth/tiktok`. APP_ID is the app's id; APP_SECRET its secret.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# QuickBooks Online (cron.ingest-quickbooks COGS ingestion). The OAuth connect
# flow (/auth/quickbooks) exchanges the merchant's consent for a rotating
# refresh token, stored encrypted in integration_credentials (kind quickbooks,
# in access_token_encrypted — same column Google uses). The client refreshes it
# into short-lived access tokens to read product purchase costs. CLIENT_ID/SECRET
# come from an Intuit developer app at https://developer.intuit.com/; its
# redirect URI must include `${SHOPIFY_APP_URL}/auth/quickbooks`.
# QBO_ENV selects the API host: sandbox | production.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox

# EasyPost ship-cost connector (cron.ingest-ship-costs true per-label cost). Unlike
# the OAuth integrations above, EasyPost needs NO app-level client id/secret: each
# merchant pastes their OWN EasyPost API key in the embedded app, stored encrypted in
# integration_credentials (kind easypost_ship, access_token_encrypted). The cron reads
# the merchant's existing account via GET /v2/shipments?purchased=true with HTTP Basic
# auth (key as username). Only override the API base for testing against a mock; leave
# unset in prod to use https://api.easypost.com/v2.
# EASYPOST_API_BASE=https://api.easypost.com/v2

# Shippo ship-cost connector (cron.ingest-ship-costs true per-label cost, connector
# #2). Co-branded OAuth: each merchant connects their OWN Shippo account from the
# embedded app (/auth/shippo); the exchange returns a NON-EXPIRING access token
# ("oauth.<token>"), stored encrypted in integration_credentials (kind shippo_ship,
# access_token_encrypted). The cron reads GET /transactions/?object_status=SUCCESS with
# `Authorization: Bearer oauth.<token>`. CLIENT_ID/SECRET are NOT self-serve — they
# require Shippo partner-program approval (https://goshippo.com/become-a-shippo-partner)
# and the redirect URI `${SHOPIFY_APP_URL}/auth/shippo` must be pre-approved by Shippo.
SHIPPO_CLIENT_ID=
SHIPPO_CLIENT_SECRET=
# Only override the API base for testing against a mock; leave unset in prod to use
# https://api.goshippo.com.
# SHIPPO_API_BASE=https://api.goshippo.com

# ShipBob ship-cost connector (3PL house, Phase 3). Like EasyPost, ShipBob needs NO
# app-level client id/secret: each merchant pastes their OWN ShipBob Personal Access Token
# (billing_read scope) in the embedded app, stored encrypted in integration_credentials
# (kind shipbob_ship). The cron reads POST /{ver}/transactions:query with a Bearer PAT.
# Only override the API base for testing against a mock; leave unset in prod.
# SHIPBOB_API_BASE=https://api.shipbob.com/2026-01

# ShipHero ship-cost connector (3PL house, Phase 3). ShipHero is CREDENTIAL/TOKEN-based, NOT
# OAuth: it needs NO app-level client id/secret and NO authorize-redirect. Each merchant
# creates a dedicated "3rd Party Developer" user in ShipHero (My Account → Developer Users)
# and is issued an access token (28-day) + a long-lived REFRESH token; they paste the REFRESH
# token in the embedded app, stored encrypted in integration_credentials (kind shiphero_ship,
# access_token_encrypted — the QuickBooks refresh-token storage model). The cron mints a fresh
# access token from it each run via POST /auth/refresh, then reads the GraphQL endpoint with a
# Bearer <access_token>. Only override the API base for testing against a mock; leave unset in
# prod (auth /auth/refresh lives at the API root — a trailing /graphql is stripped for it).
# SHIPHERO_API_BASE=https://public-api.shiphero.com/graphql

# === Web dashboard (calderyncompany.com/dashboard) ===
# 32+ char random secret; HMAC pepper for hashing dashboard session tokens.
DASHBOARD_SESSION_PEPPER=replace-with-32-byte-random-hex
# Public origin the dashboard is served from. https://calderyncompany.com in
# production (the marketing site proxies /dashboard/* to this app); set to this
# app's own URL in dev so the OAuth round-trip stays on one origin.
DASHBOARD_PUBLIC_URL=https://calderyncompany.com
# Supabase project JWT secret (Settings → API → JWT Secret). Used to sign the
# short-lived shop-scoped Realtime tokens minted at /dashboard/api/realtime-token.
SUPABASE_JWT_SECRET=

# === MCP OAuth 2.1 (Claude.ai connector flow) ===
# Master flag. When false, /oauth/* routes 404 and the discovery doc is not served.
MCP_OAUTH_ENABLED=false
# 64+ character hex secret used to sign the pending-OAuth state cookie.
# Generate with: openssl rand -hex 32
MCP_OAUTH_COOKIE_SECRET=

# === Meta Graph API client throttle (optional tuning) ===
# Per-shop, per-process self-throttle kept below Meta's dev-tier
# ads-management budget (300 calls/rolling hour → error code 80004).
META_MAX_CALLS_PER_HOUR=250
META_MIN_CALL_INTERVAL_MS=200

# === Pilot onboarding invite (app/routes/pilot.*) ===
# Bearer secret the admin /panel backend sends to POST /pilot/api/send-invite.
# Generate with: openssl rand -hex 32
PILOT_INVITE_SECRET=
# HMAC key for the RFC 8058 unsubscribe tokens. Generate with: openssl rand -hex 32
PILOT_UNSUB_SECRET=
# From address for pilot invites; the domain must be verified in Resend.
# (RESEND_API_KEY above is reused for delivery.)
PILOT_FROM=Calderyn <onboarding@calderyncompany.com>
# Canonical app origin for absolute email asset/link URLs. Optional — falls back
# to SHOPIFY_APP_URL, then the inbound request origin.
PUBLIC_APP_URL=

# === Stripe (TEST mode — payments spike) ===
# Server-only secret key (sk_test_...). Read via process.env in *.server.ts only; never in a client bundle.
STRIPE_SECRET_KEY=
# Server-only webhook signing secret (whsec_...). Printed by `stripe listen` (dev) or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Client-exposed publishable key (pk_test_...). The ONLY Stripe key allowed in the browser bundle.
STRIPE_PUBLISHABLE_KEY=
# From address for buyer order-confirmation emails (#2c-2). Optional — falls back to PILOT_FROM,
# then DIGEST_FROM. Domain must be verified in Resend; RESEND_API_KEY above is reused for delivery.
ORDER_CONFIRM_FROM=
