SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SCOPES=read_products,read_inventory,write_inventory,read_orders,read_locations
SHOPIFY_APP_URL=https://example.com

# Supabase (server-only — service role key bypasses RLS)
SUPABASE_URL=https://ajgrmnvzxfxxlwrxcgnu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Prisma session storage.
# Use the "Transaction pooler" connection string (port 6543) from Supabase
# Project Settings → Database → Connection String → URI, with
# `?pgbouncer=true&connection_limit=1` appended for Prisma.
DATABASE_URL=

# Direct connection for `prisma migrate dev` (migrations cannot run through
# the transaction pooler). Use the "Session pooler" string (port 5432).
DIRECT_URL=

# Calderyn backend wiring (legacy; superseded by Supabase. Leave empty.)
CALDERYN_API_URL=
CALDERYN_SERVICE_TOKEN=

# HMAC pepper for hashing MCP bearer tokens. 32+ random bytes (hex).
# Must match the value set in calderyn-mcp's Vercel env. Rotating it invalidates all live tokens.
MCP_TOKEN_PEPPER=replace-with-32-byte-random-hex

# Shared secret for authenticating Vercel Cron requests to /cron/ingest
# and the /api/engine/run python function. 32+ random bytes (hex).
# Set the same value in Vercel project env.
CRON_SECRET=replace-with-32-byte-random-hex

# Python detector engine (Vercel python fn at /api/engine/run).
# The engine connects via asyncpg using DATABASE_URL above (transaction
# pooler is fine: the pool is created with statement_cache_size=0, see
# engine/calderyn_engine/db.py). Additional keys it needs:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
# Leave MOAT_PEPPER unset: no moat_* tables exist, so the moat layer is a no-op.

# Engine DB-backed tests ONLY. Points at a DISPOSABLE LOCAL Postgres carrying
# the engine schema (see tests/engine/scripts/test-db.sh). The engine test
# suite reads ONLY this var (never DATABASE_URL) and refuses any non-loopback
# host, so it can never read or mutate a shared/remote database. Leave unset to
# skip the DB-backed tests. Never point this at Supabase or any real database.
TEST_DATABASE_URL=postgres://postgres:test@localhost:5433/calderyn_test

# AES-256-GCM key for encrypting stored integration OAuth tokens at rest.
# Exactly 32 bytes as 64 hex chars.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-char-random-hex

# Onboarding skip-setup shortcut. Renders a "Skip setup → dashboard" button that
# bypasses guardrail setup and privacy/consent. ONLY set to "true" on
# preview/staging while OAuth providers are being wired. MUST be unset (or any
# value other than "true") in the production merchant environment.
ONBOARDING_DEV_BYPASS=

# Meta (Facebook) Marketing API. A developer app in Development mode is enough to
# test pause/resume on your own ad account (no App Review required).
META_APP_ID=
META_APP_SECRET=

# Anthropic API — in-app assistant (server-only; never in a client bundle).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model string is verified against the live API at build time (spec §10.1).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Higgsfield — ad-creative image generation (screener "Improve → Image"; server-only).
# Key + secret pair from cloud.higgsfield.ai → API. Both required, or image gen stays
# gated off in the UI. Auth header is `Key {key}:{secret}`.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Daily caps on image generation (shared Higgsfield account). Optional — these are
# the defaults. Per-merchant cap and a global backstop so the bill can't run away.
IMAGE_GEN_DAILY_PER_SHOP=20
IMAGE_GEN_DAILY_GLOBAL=300

# Google Ads API (cron.ingest-ads ad-spend ingestion). The OAuth connect flow
# (/auth/google) exchanges the merchant's consent for a long-lived refresh
# token, stores it encrypted in integration_credentials (kind google_ads), and
# the Google adapter refreshes it into access tokens to call the Ads REST API.
# CLIENT_ID/SECRET come from a Google Cloud OAuth 2.0 client (Web application)
# whose authorized redirect URI must include `${SHOPIFY_APP_URL}/auth/google`.
# DEVELOPER_TOKEN comes from the Google Ads API Center (an approved token is
# required for production traffic; a test token works against test accounts).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# TikTok Business (Marketing API). The OAuth connect flow (/auth/tiktok)
# exchanges the merchant's auth code for an access token + advertiser id, stored
# encrypted in integration_credentials (kind tiktok_ads). Least-privilege scopes
# only (advertiser reporting + campaign read/manage). Create a developer app at
# https://business-api.tiktok.com/; its redirect/callback URL must be set to
# `${SHOPIFY_APP_URL}/auth/tiktok`. APP_ID is the app's id; APP_SECRET its secret.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# QuickBooks Online (cron.ingest-quickbooks COGS ingestion). The OAuth connect
# flow (/auth/quickbooks) exchanges the merchant's consent for a rotating
# refresh token, stored encrypted in integration_credentials (kind quickbooks,
# in access_token_encrypted — same column Google uses). The client refreshes it
# into short-lived access tokens to read product purchase costs. CLIENT_ID/SECRET
# come from an Intuit developer app at https://developer.intuit.com/; its
# redirect URI must include `${SHOPIFY_APP_URL}/auth/quickbooks`.
# QBO_ENV selects the API host: sandbox | production.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox

# === Web dashboard (calderyncompany.com/dashboard) ===
# 32+ char random secret; HMAC pepper for hashing dashboard session tokens.
DASHBOARD_SESSION_PEPPER=replace-with-32-byte-random-hex
# Public origin the dashboard is served from. https://calderyncompany.com in
# production (the marketing site proxies /dashboard/* to this app); set to this
# app's own URL in dev so the OAuth round-trip stays on one origin.
DASHBOARD_PUBLIC_URL=https://calderyncompany.com
# Supabase project JWT secret (Settings → API → JWT Secret). Used to sign the
# short-lived shop-scoped Realtime tokens minted at /dashboard/api/realtime-token.
SUPABASE_JWT_SECRET=

# === MCP OAuth 2.1 (Claude.ai connector flow) ===
# Master flag. When false, /oauth/* routes 404 and the discovery doc is not served.
MCP_OAUTH_ENABLED=false
# 64+ character hex secret used to sign the pending-OAuth state cookie.
# Generate with: openssl rand -hex 32
MCP_OAUTH_COOKIE_SECRET=
