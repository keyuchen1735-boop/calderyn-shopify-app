{
  "framework": "remix",
  "buildCommand": "npm run build",
  "installCommand": "npm install && npx prisma generate",
  "regions": ["pdx1"],
  "functions": {
    "api/engine/run.py": { "maxDuration": 300, "includeFiles": "engine/**" },
    "api/engine/moat_train.py": { "maxDuration": 300, "includeFiles": "engine/**" },
    "api/engine/autopilot_train.py": { "maxDuration": 300, "includeFiles": "engine/**" },
    "app/routes/dashboard.api.orders.bulk.fulfill.tsx": { "maxDuration": 60 },
    "app/routes/dashboard.api.orders.export.tsx": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/oauth/authorization-server-metadata"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), browsing-topics=(), usb=(), interest-cohort=()"
        },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "crons": [
    { "path": "/cron/ingest", "schedule": "*/30 * * * *" },
    { "path": "/cron/import", "schedule": "*/5 * * * *" },
    { "path": "/cron/detect", "schedule": "15,45 * * * *" },
    { "path": "/cron/ingest-ads", "schedule": "0 * * * *" },
    { "path": "/cron/gdpr", "schedule": "0 4 * * *" },
    { "path": "/cron/action-retry", "schedule": "*/15 * * * *" },
    { "path": "/cron/autopilot", "schedule": "0,30 * * * *" },
    { "path": "/cron/weather-suggest", "schedule": "0 7 * * *" },
    { "path": "/cron/weather-merch", "schedule": "0 */6 * * *" },
    { "path": "/cron/ingest-quickbooks", "schedule": "0 5 * * *" },
    { "path": "/cron/ingest-ship-costs", "schedule": "0 6 * * *" },
    { "path": "/cron/mcp-oauth-cleanup", "schedule": "0 4 * * *" },
    { "path": "/cron/github-digest", "schedule": "0 14 * * *" },
    { "path": "/cron/moat-train", "schedule": "0 3 * * *" },
    { "path": "/cron/autopilot-train", "schedule": "0 4 * * *" },
    { "path": "/cron/calibration-recompute", "schedule": "45 * * * *" },
    { "path": "/cron/social-digest", "schedule": "0 14 * * 5" },
    { "path": "/cron/inventory-reaper", "schedule": "*/5 * * * *" },
    { "path": "/cron/order-reaper", "schedule": "20 * * * *" },
    { "path": "/cron/sourcing", "schedule": "0 2 * * *" },
    { "path": "/cron/assets", "schedule": "30 3 * * *" }
  ]
}
